<%
  // Līniju ikonas pakalpojumu kartītēm (rāda, kamēr nav augšupielādēts foto)
  const svg = (inner) => '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + inner + '</svg>';
  const icons = {
    bulb: svg('<path d="M32 8a17 17 0 0 0-9.5 31.1c1.6 1.1 2.5 2.7 2.5 4.5V46h14v-2.4c0-1.8.9-3.4 2.5-4.5A17 17 0 0 0 32 8z"/><path d="M26 52h12M28 57h8"/><path d="M32 18v10M27 23l5 5 5-5"/>'),
    estimate: svg('<rect x="12" y="8" width="40" height="48" rx="3"/><path d="M20 20h24M20 29h24M20 38h12"/><path d="M38 46l4 4 8-9"/>'),
    truck: svg('<path d="M6 16h30v28H6z"/><path d="M36 26h12l8 9v9H36z"/><circle cx="18" cy="48" r="5"/><circle cx="46" cy="48" r="5"/><path d="M13 48H6M23 48h18"/>'),
    trailer: svg('<rect x="14" y="20" width="36" height="22" rx="2"/><circle cx="32" cy="31" r="7"/><circle cx="32" cy="31" r="2"/><path d="M14 36H4M50 36h6"/><circle cx="24" cy="48" r="5"/><circle cx="40" cy="48" r="5"/>')
  };
%>
<!DOCTYPE html>
<html lang="lv">
<head>
<%- include('partials/head', { pageTitle: 'ELSPOT — ' + page.title, editMode }) %>
</head>
<body class="<%= editMode ? 'admin-mode' : '' %>"<% if (editMode) { %> data-page-slug="<%= slug %>"<% } %>>

<% if (editMode) { %><%- include('partials/admin-bar') %><% } %>

<%- include('partials/nav') %>

<section class="product-categories page-top-pad">
  <div class="section-head">
    <div class="eyebrow">Pakalpojumi</div>
    <h2<%- editAttrs(editMode, 'heading') %>><%= page.heading %></h2>
    <p class="product-categories-intro"<%- editAttrs(editMode, 'intro') %>><%= page.intro %></p>
  </div>

  <div class="product-grid service-grid">
    <% page.items.forEach(function(item, i) { %>
      <div class="product-card service-card">
        <div class="product-card-media">
          <% if (item.video) { %>
            <video class="service-video<%= item.videoFit === 'contain' ? ' is-contain' : '' %>" muted loop playsinline preload="auto" poster="<%= item.poster || item.image || '' %>" aria-label="<%= item.title %> — animācija">
              <source src="<%= item.video %>" type="video/mp4">
            </video>
            <span class="service-video-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
          <% } else if (item.image) { %>
            <div class="product-card-image" style="background-image:url('<%= item.image %>')"></div>
          <% } else { %>
            <div class="product-card-placeholder service-card-icon"><%- icons[item.icon] || icons.bulb %></div>
          <% } %>
          <% if (editMode && !item.video) { %>
            <button type="button" class="adm-image-btn product-card-image-btn" data-image-field="pakalpojumi.items.<%= i %>.image">🖼 Mainīt attēlu</button>
          <% } %>
        </div>
        <div class="product-card-title"<%- editAttrs(editMode, 'items.' + i + '.title') %>><%= item.title %></div>
      </div>
    <% }) %>
  </div>

  <div class="service-note">
    <div class="service-note-main">
      <div class="eyebrow">Papildu pakalpojumi</div>
      <h3<%- editAttrs(editMode, 'noteHeading') %>><%= page.noteHeading %></h3>
      <p<%- editAttrs(editMode, 'noteText') %>><%= page.noteText %></p>
      <ul class="service-chips">
        <% page.extras.forEach(function(ex, i) { %>
          <li<%- editAttrs(editMode, 'extras.' + i + '.title') %>><%= ex.title %></li>
        <% }) %>
      </ul>
    </div>
    <div class="service-note-cta">
      <a href="<%= editMode ? 'javascript:void(0)' : '#' %>" class="btn btn-primary" <%= editMode ? '' : 'data-open-quote' %>>Sazināties ar speciālistu</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<% if (!editMode) { %><%- include('partials/quote-modal') %><% } %>

<script src="/js/main.js"></script>
<% if (editMode) { %><script src="/js/admin-edit.js"></script><% } %>
</body>
</html>
