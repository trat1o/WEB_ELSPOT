<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#000000">
<title>ELSPOT</title>
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/maintenance.css">
</head>
<body>

<div class="mt-glow mt-glow-beam"></div>
<div class="mt-glow mt-glow-floor"></div>

<main class="mt-stage">
  <img class="mt-logo" src="<%= site.logoInverse %>" alt="ELSPOT">

  <h1 class="mt-title">Something bright is coming soon.</h1>
  <p class="mt-text">
    We are building a new website for ELSPOT &mdash; your partner for electrical materials and lighting.
    Please check back shortly.
  </p>

  <div class="mt-divider"></div>

  <p class="mt-contact-lead">In the meantime, we are always happy to help:</p>
  <p class="mt-contact">
    <% if (contact.email) { %><a href="mailto:<%= contact.email %>"><%= contact.email %></a><% } %>
    <% if (contact.email && contact.phone) { %><span class="mt-dot" aria-hidden="true">&bull;</span><% } %>
    <% if (contact.phone) { %><a href="tel:<%= String(contact.phone).replace(/[^+\d]/g, '') %>"><%= contact.phone %></a><% } %>
  </p>
</main>

<footer class="mt-footer">&copy; <%= new Date().getFullYear() %> ELSPOT SIA &middot; Riga, Latvia</footer>

</body>
</html>
