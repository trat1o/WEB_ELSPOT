<!DOCTYPE html>
<html lang="lv">
<head>
<%- include('partials/head', { pageTitle: 'ELSPOT — ' + page.heading, editMode }) %>
</head>
<body class="<%= editMode ? 'admin-mode' : '' %>"<% if (editMode) { %> data-page-slug="<%= slug %>"<% } %>>


<% if (editMode) { %><%- include('partials/admin-bar') %><% } %>

<%- include('partials/nav') %>

<section class="intro page-intro">
  <div>
    <div class="eyebrow"<%- editAttrs(editMode, 'eyebrow') %>><%= page.eyebrow %></div>
    <h2<%- editAttrs(editMode, 'heading') %>><%= page.heading %></h2>
  </div>
  <div class="intro-text">
    <p<%- editAttrs(editMode, 'text1') %>><%= page.text1 %></p>
    <p<%- editAttrs(editMode, 'text2') %>><%= page.text2 %></p>
    <p<%- editAttrs(editMode, 'text3') %>><%= page.text3 %></p>
  </div>
</section>

<section class="motto-section">
  <div class="eyebrow"<%- editAttrs(editMode, 'mottoEyebrow') %>><%= page.mottoEyebrow %></div>
  <p class="motto-text"<%- editAttrs(editMode, 'motto') %>><%= page.motto %></p>
</section>

<%- include('partials/footer') %>
<% if (!editMode) { %><%- include('partials/quote-modal') %><% } %>

<script src="/js/main.js"></script>
<% if (editMode) { %><script src="/js/admin-edit.js"></script><% } %>
</body>
</html>
