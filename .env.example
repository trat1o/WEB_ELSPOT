PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
# Ģenerē ar: npm run hash-password -- "tava-parole"
ADMIN_PASSWORD_HASH=

# Neon/Postgres savienojuma virkne (Vercel Storage cilnē -> Neon integrācija -> .env.local piemērs)
DATABASE_URL=

# Vercel Blob rakstīšanas talons (Vercel Storage cilnē -> Blob -> .env.local piemērs)
BLOB_READ_WRITE_TOKEN=

# SMTP dati e-pasta paziņojumiem par cenu pieprasījumiem
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# No kā e-pasti tiks sūtīti (parasti tas pats, kas SMTP_USER)
MAIL_FROM=
# Uz kuru adresi sūtīt cenu pieprasījumus (noklusējums: sales@elspot.lv)
MAIL_TO=sales@elspot.lv
