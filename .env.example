PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
# Ģenerē ar: npm run hash-password -- "tava-parole"
ADMIN_PASSWORD_HASH=

# Neon/Postgres savienojuma virkne (Vercel Storage cilnē -> Neon integrācija -> .env.local piemērs)
DATABASE_URL=

# Vercel Blob rakstīšanas talons (Vercel Storage cilnē -> Blob -> .env.local piemērs)
BLOB_READ_WRITE_TOKEN=
